{
  "name": "@wasafili/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Traitements asynchrones BullMQ : rapports PDF, e-mails, automatisations, webhooks",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
