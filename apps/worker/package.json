    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "15.1.3",
    "sharp": "^0.35.5",
    "undici": "^8.12.2",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.15"
  }
