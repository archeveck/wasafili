{
  "name": "@tesserax/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST Tesserax (NestJS + Prisma + PostgreSQL)",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesserax/form-engine": "workspace:*",
    "@tesserax/form-schema": "workspace:*",
    "@tesserax/jobs": "workspace:*",
    "bullmq": "^6.3.16",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "read-excel-file": "^9.3.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@tesserax/sdk": "workspace:*",
    "@tesserax/sync": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0"
  }
}
