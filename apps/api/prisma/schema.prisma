// Schéma Tesserax — Phase 0 (identité, tenants, RBAC).
//
// Multi-tenant (ADR 0001) : toute table métier porte `instance_id` et est protégée par une
// policy RLS (voir la migration `init`). Les tables `instances`, `users` et `refresh_tokens`
// forment le registre d'identité : elles ne contiennent aucune donnée propre à une instance.
// Les relations entre tables d'une même instance passent par des clés étrangères composites
// (id, instance_id) : une ligne ne peut jamais référencer une ligne d'une autre instance.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Instance {
  id         String   @id @default(uuid()) @db.Uuid
  /// Identifiant court utilisé dans les URL (`/v1/{short}/...`).
  short      String   @unique
  name       String
  timeZone   String   @default("Africa/Abidjan") @map("time_zone")
  locale     String   @default("fr")
  /// Personnalisation (P2.7) : `{ logoFileId?, primaryColor?, accentColor? }`.
  branding   Json     @default("{}")
  /// Menu de l'application mobile : tuiles `{ id, label, icon, structureId? }`.
  mobileMenu Json     @default("[]") @map("mobile_menu")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         Role[]
  memberships   Membership[]
  groups        Group[]
  groupMembers  GroupMember[]
  oauthClients  OAuthClient[]
  structures    Structure[]
  versions      StructureVersion[]
  submissions   Submission[]
  revisions     SubmissionRevision[]
  lists         List[]
  listItems     ListItem[]
  accesses      StructureAccess[]
  files         File[]
  conflicts     SubmissionConflict[]
  tasks         Task[]
  notifications Notification[]
  pushTokens    PushToken[]

  @@map("instances")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Toujours stocké en minuscules.
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  groupMembers  GroupMember[]
  refreshTokens RefreshToken[]
  submissions   Submission[]
  revisions     SubmissionRevision[]
  assignedTasks Task[]               @relation("TaskAssignee")
  notifications Notification[]
  pushTokens    PushToken[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @map("instance_id") @db.Uuid
  /// Clé stable (`admin`, `superviseur`, `technicien`, ou personnalisée).
  key         String
  name        String
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance    Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  memberships Membership[]
  accesses    StructureAccess[]

  @@unique([instanceId, key])
  @@unique([id, instanceId])
  @@map("roles")
}

model Membership {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  /// Attributs du membre (ex. `{ "site": "<id d'élément>" }`) pour les filtres de visibilité.
  attributes Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId, instanceId], references: [id, instanceId])

  @@unique([instanceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Group {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  accesses StructureAccess[]
  tasks    Task[]

  @@unique([instanceId, name])
  @@unique([id, instanceId])
  @@map("groups")
}

model GroupMember {
  instanceId String   @map("instance_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId, instanceId], references: [id, instanceId], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

/// Client OAuth2 `client_credentials` (intégrations : n8n, ERP…), rattaché à une instance.
model OAuthClient {
  id         String    @id @default(uuid()) @db.Uuid
  instanceId String    @map("instance_id") @db.Uuid
  /// Identifiant public, unique sur toute la plateforme.
  clientId   String    @unique @map("client_id")
  /// SHA-256 du secret (secret aléatoire de 256 bits, jamais stocké en clair).
  secretHash String    @map("secret_hash")
  name       String
  /// Permissions accordées au client (même catalogue que les rôles).
  scopes     String[]
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("oauth_clients")
}

/// Refresh token rotatif (ADR 0002). Une famille = une session de connexion.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 du jeton opaque remis au client.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Renseigné quand le jeton a été échangé ; le réutiliser révoque toute la famille.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Phase 1 — structures, fiches, référentiels
// ---------------------------------------------------------------------------

/// Structure (formulaire). Sa définition vit dans des versions immuables une fois publiées.
model Structure {
  id          String              @id @default(uuid()) @db.Uuid
  /// Transaction de la dernière écriture (curseur de synchronisation, ADR 0007).
  syncTxid    Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("sync_txid")
  instanceId  String              @map("instance_id") @db.Uuid
  name        String
  description String?
  archivedAt  DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance    Instance           @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  versions    StructureVersion[]
  submissions Submission[]
  accesses    StructureAccess[]
  tasks       Task[]

  @@unique([id, instanceId])
  @@index([instanceId, name])
  @@map("structures")
}

enum StructureVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Version d'une structure : au plus un brouillon et une version publiée (courante) à la fois.
/// Une version publiée ou archivée est immuable (trigger) ; ses fiches y restent liées.
model StructureVersion {
  id          String                 @id @default(uuid()) @db.Uuid
  instanceId  String                 @map("instance_id") @db.Uuid
  structureId String                 @map("structure_id") @db.Uuid
  version     Int
  status      StructureVersionStatus @default(DRAFT)
  definition  Json
  publishedAt DateTime?              @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  structure   Structure    @relation(fields: [structureId, instanceId], references: [id, instanceId], onDelete: Cascade)
  submissions Submission[]

  @@unique([structureId, version])
  @@unique([id, instanceId])
  @@map("structure_versions")
}

/// Fiche : saisie d'une version de structure. `id` peut être généré par le client (hors ligne).
model Submission {
  id                 String              @id @default(uuid()) @db.Uuid
  /// Transaction de la dernière écriture (curseur de synchronisation, ADR 0007).
  syncTxid           Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("sync_txid")
  instanceId         String              @map("instance_id") @db.Uuid
  structureId        String              @map("structure_id") @db.Uuid
  structureVersionId String              @map("structure_version_id") @db.Uuid
  /// Données validées par la version de structure (JSONB, index GIN).
  data               Json
  /// État de workflow (Phase 4) ; null sans workflow.
  state              String?
  /// Auteur ; null pour une fiche créée par un client d'intégration.
  authorId           String?             @map("author_id") @db.Uuid
  /// Incrémenté à chaque modification ; sert de base aux mutations hors ligne (D9).
  revision           Int                 @default(1)
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance  Instance             @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  structure Structure            @relation(fields: [structureId, instanceId], references: [id, instanceId], onDelete: NoAction)
  version   StructureVersion     @relation(fields: [structureVersionId, instanceId], references: [id, instanceId], onDelete: NoAction)
  author    User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  revisions SubmissionRevision[]
  conflicts SubmissionConflict[]
  tasks     Task[]

  @@unique([id, instanceId])
  @@index([instanceId, structureId, createdAt])
  @@index([instanceId, updatedAt])
  @@map("submissions")
}

/// Historique champ par champ (D11) ; porte aussi l'idempotence des mutations.
model SubmissionRevision {
  id               String   @id @default(uuid()) @db.Uuid
  instanceId       String   @map("instance_id") @db.Uuid
  submissionId     String   @map("submission_id") @db.Uuid
  revision         Int
  /// `create`, `update` ou `delete`.
  action           String
  authorId         String?  @map("author_id") @db.Uuid
  /// Identifiant de mutation fourni par le client : rejouer la même mutation est sans effet.
  clientMutationId String?  @map("client_mutation_id")
  /// `[{ field, before, after }]`
  changes          Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  instance   Instance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId, instanceId], references: [id, instanceId], onDelete: Cascade)
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([submissionId, revision])
  @@unique([instanceId, clientMutationId])
  @@map("submission_revisions")
}

/// Référentiel hiérarchique (ex. Site > Bâtiment > Équipement).
model List {
  id          String              @id @default(uuid()) @db.Uuid
  /// Transaction de la dernière écriture (curseur de synchronisation, ADR 0007).
  syncTxid    Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("sync_txid")
  instanceId  String              @map("instance_id") @db.Uuid
  name        String
  description String?
  /// Libellés des niveaux, de la racine aux feuilles.
  levels      String[]
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance Instance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  items    ListItem[]

  @@unique([instanceId, name])
  @@unique([id, instanceId])
  @@map("lists")
}

model ListItem {
  id         String              @id @default(uuid()) @db.Uuid
  /// Transaction de la dernière écriture (curseur de synchronisation, ADR 0007).
  syncTxid   Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("sync_txid")
  instanceId String              @map("instance_id") @db.Uuid
  listId     String              @map("list_id") @db.Uuid
  parentId   String?             @map("parent_id") @db.Uuid
  /// Profondeur (0 = racine) ; égale à celle du parent + 1.
  level      Int
  /// Code métier unique dans la liste (QR code, import) ; facultatif.
  code       String?
  label      String
  attributes Json                @default("{}")
  position   Int                 @default(0)
  /// Un élément utilisé par des fiches n'est jamais supprimé, seulement archivé.
  archivedAt DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance Instance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  list     List       @relation(fields: [listId, instanceId], references: [id, instanceId], onDelete: Cascade)
  parent   ListItem?  @relation("ListItemTree", fields: [parentId, instanceId], references: [id, instanceId], onDelete: NoAction)
  children ListItem[] @relation("ListItemTree")

  @@unique([listId, code])
  @@unique([id, instanceId])
  @@index([listId, parentId, position])
  @@index([instanceId, code])
  @@map("list_items")
}

// ---------------------------------------------------------------------------
// Phase 2 — droits par structure, fichiers
// ---------------------------------------------------------------------------

/// Droits d'un rôle ou d'un groupe sur une structure (P2.6.2). Sans aucune règle, ce sont les
/// permissions d'instance du rôle qui s'appliquent.
model StructureAccess {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @map("instance_id") @db.Uuid
  structureId String   @map("structure_id") @db.Uuid
  /// Exactement un des deux (contrainte CHECK).
  roleId      String?  @map("role_id") @db.Uuid
  groupId     String?  @map("group_id") @db.Uuid
  /// Sous-ensemble de `create`, `read:all`, `read:own`, `update`, `delete`, `export`.
  permissions String[]
  /// Filtres de visibilité `[{ key, operator, value }]` ; `value` peut valoir `$user.id` ou
  /// `$user.<attribut>`. Absent : toutes les fiches permises par `permissions`.
  visibility  Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance  Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  structure Structure @relation(fields: [structureId, instanceId], references: [id, instanceId], onDelete: Cascade)
  role      Role?     @relation(fields: [roleId, instanceId], references: [id, instanceId], onDelete: NoAction)
  group     Group?    @relation(fields: [groupId, instanceId], references: [id, instanceId], onDelete: NoAction)

  @@unique([structureId, roleId])
  @@unique([structureId, groupId])
  @@map("structure_accesses")
}

/// Fichier téléversé directement dans le stockage S3 par URL signée (D10). L'identifiant peut
/// être généré par le client : la fiche le référence quel que soit l'ordre d'arrivée.
model File {
  id           String   @id @default(uuid()) @db.Uuid
  instanceId   String   @map("instance_id") @db.Uuid
  /// Clé de l'objet dans le bucket.
  key          String
  name         String
  mimeType     String   @map("mime_type")
  size         Int
  /// `pending` (URL émise) puis `uploaded` (objet vérifié).
  status       String   @default("pending")
  thumbnailKey String?  @map("thumbnail_key")
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([id, instanceId])
  @@map("files")
}

// ---------------------------------------------------------------------------
// Phase 3 — synchronisation hors ligne
// ---------------------------------------------------------------------------

/// Conflit de modification sur un champ (D9) : deux écritures concurrentes depuis la même
/// révision. La dernière reçue par le serveur gagne ; la valeur écrasée est conservée ici.
model SubmissionConflict {
  id               String    @id @default(uuid()) @db.Uuid
  instanceId       String    @map("instance_id") @db.Uuid
  submissionId     String    @map("submission_id") @db.Uuid
  field            String
  /// Révision sur laquelle le client a fondé sa modification.
  baseRevision     Int       @map("base_revision")
  /// Révision créée par l'écriture gagnante.
  appliedRevision  Int       @map("applied_revision")
  /// `{ "value": … }` : valeur appliquée (gagnante).
  appliedValue     Json      @map("applied_value")
  /// `{ "value": … }` : valeur écrasée (écriture concurrente perdue).
  overwrittenValue Json      @map("overwritten_value")
  clientMutationId String?   @map("client_mutation_id")
  authorId         String?   @map("author_id") @db.Uuid
  /// `kept` (valeur appliquée conservée) ou `restored` (valeur écrasée rétablie).
  resolution       String?
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById     String?   @map("resolved_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  instance   Instance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId, instanceId], references: [id, instanceId], onDelete: Cascade)

  @@index([instanceId, submissionId])
  @@map("submission_conflicts")
}

// ---------------------------------------------------------------------------
// Phase 4 — tâches et notifications
// ---------------------------------------------------------------------------

/// Fiche planifiée (P4.4) : formulaire à remplir, assigné à un utilisateur ou à un groupe.
/// L'identifiant peut venir du client. Une fiche créée depuis la tâche la clôt.
model Task {
  id              String              @id @default(uuid()) @db.Uuid
  /// Transaction de la dernière écriture (curseur de synchronisation, ADR 0007).
  syncTxid        Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("sync_txid")
  instanceId      String              @map("instance_id") @db.Uuid
  structureId     String              @map("structure_id") @db.Uuid
  title           String
  description     String?
  assigneeUserId  String?             @map("assignee_user_id") @db.Uuid
  assigneeGroupId String?             @map("assignee_group_id") @db.Uuid
  startAt         DateTime            @map("start_at") @db.Timestamptz(3)
  endAt           DateTime            @map("end_at") @db.Timestamptz(3)
  /// Échéance (facultative), distincte du créneau planifié.
  dueAt           DateTime?           @map("due_at") @db.Timestamptz(3)
  locationLabel   String?             @map("location_label")
  latitude        Float?
  longitude       Float?
  /// Valeurs de pré-remplissage de la fiche (ex. `{ "equipement": "<id>" }`).
  prefill         Json                @default("{}")
  /// `todo`, `in_progress`, `done` ou `cancelled`.
  status          String              @default("todo")
  submissionId    String?             @map("submission_id") @db.Uuid
  createdById     String?             @map("created_by_id") @db.Uuid
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance      Instance    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  structure     Structure   @relation(fields: [structureId, instanceId], references: [id, instanceId], onDelete: NoAction)
  assigneeUser  User?       @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeGroup Group?      @relation(fields: [assigneeGroupId, instanceId], references: [id, instanceId], onDelete: NoAction)
  submission    Submission? @relation(fields: [submissionId, instanceId], references: [id, instanceId], onDelete: NoAction)

  @@unique([id, instanceId])
  @@index([instanceId, startAt])
  @@index([instanceId, assigneeUserId])
  @@map("tasks")
}

/// Notification d'un utilisateur (P4.5, D1). Synchronisée vers le mobile (source de vérité) ;
/// le push n'en est qu'un relais facultatif.
model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  syncTxid   Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()")) @map("sync_txid")
  instanceId String              @map("instance_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  /// `task_assigned` ou `submission_state`.
  type       String
  title      String
  body       String?
  /// Cible : `{ taskId? , submissionId?, structureId? }`.
  data       Json                @default("{}")
  readAt     DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([instanceId, userId, createdAt])
  @@map("notifications")
}

/// Jeton Expo Push d'un appareil. Le supprimer désactive le push pour cet appareil.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  instanceId String   @map("instance_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String
  platform   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instanceId, token])
  @@index([instanceId, userId])
  @@map("push_tokens")
}
