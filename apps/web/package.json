    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^8.21.3",
    "@tesserax/form-engine": "workspace:*",
    "@tesserax/form-renderer": "workspace:*",
    "@tesserax/form-schema": "workspace:*",
    "@tesserax/i18n": "workspace:*",
    "@tesserax/sdk": "workspace:*",
    "@tesserax/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.2",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
