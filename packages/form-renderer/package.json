{
  "name": "@tesserax/form-renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Contrat et composants de champs partagés web/mobile",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
