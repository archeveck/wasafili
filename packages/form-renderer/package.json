    "@tesserax/form-schema": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
