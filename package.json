{
  "name": "tesserax",
  "private": true,
  "type": "module",
  "description": "Tesserax — plateforme no-code de collecte de données terrain (back-office web + mobile hors ligne)",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres redis minio gotenberg mailpit && docker compose -f infra/docker-compose.yml run --rm minio-init",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @tesserax/api db:migrate",
    "db:seed": "pnpm --filter @tesserax/api db:seed",
    "prepare": "husky",
    "db:deploy": "pnpm --filter @tesserax/api db:deploy",
    "test:e2e": "pnpm --filter @tesserax/web test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
