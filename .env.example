# Copier en `.env` à la racine. Les applications (api, worker) le chargent en développement ;
# en conteneur, les variables viennent de docker compose. Les valeurs ci-dessous correspondent
# à l'infra de dev (`pnpm infra:up`) — à remplacer intégralement en production.

# --- Commun ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- PostgreSQL ---
# Rôle applicatif (soumis à la RLS) : utilisé par l'api et le worker.
DATABASE_URL=postgresql://wasafili_app:wasafili_app@localhost:5440/wasafili
# Rôle propriétaire : utilisé uniquement par les migrations et le seed.
DATABASE_OWNER_URL=postgresql://wasafili_owner:wasafili_owner@localhost:5440/wasafili
# Base dédiée aux tests d'intégration (vidée par les tests).
TEST_DATABASE_URL=postgresql://wasafili_app:wasafili_app@localhost:5440/wasafili_test
TEST_DATABASE_OWNER_URL=postgresql://wasafili_owner:wasafili_owner@localhost:5440/wasafili_test

# --- Redis (BullMQ, rate limiting) ---
REDIS_URL=redis://localhost:6379
# Préfixe des files de jobs : à changer si plusieurs environnements partagent ce Redis.
QUEUE_PREFIX=wasafili

# --- API ---
API_PORT=3000
# Secret de signature des jetons d'accès (HS256), 32 caractères minimum.
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Durées de vie (secondes)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Origines autorisées (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# --- Notifications push (D1) ---
# Les notifications arrivent toujours par la synchronisation ; le push Expo n'est qu'un relais.
PUSH_ENABLED=false
# Service d'envoi (worker) et jeton d'accès Expo facultatif.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_ACCESS_TOKEN=

# --- Rapports PDF (P5.1) ---
# Conversion DOCX → PDF. Absent : génération des rapports indisponible (503).
GOTENBERG_URL=http://localhost:3001
# Adresse publique du back-office (liens dans les e-mails).
APP_URL=http://localhost:5173

# --- E-mails (P5.2, D5) : envoyés par le worker ---
# En dev, Mailpit (interface : http://localhost:8025). En production : relais SMTP du client,
# ex. smtps://utilisateur:motdepasse@smtp.exemple.ci:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Wasafili <no-reply@wasafili.local>"

# --- Webhooks sortants (P5.4) ---
# Autoriser les adresses privées (réseau local, n8n interne). Laisser à false en production
# si les webhooks ne visent que des services publics : protège le réseau interne (SSRF).
WEBHOOK_ALLOW_PRIVATE=true

# --- Stockage de fichiers (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
# Adresse vue des navigateurs et du mobile pour les URL signées (défaut : S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=wasafili
S3_SECRET_KEY=wasafili-minio-secret
# Taille maximale d'un fichier (octets) — 25 Mo.
MAX_UPLOAD_BYTES=26214400

# --- Mots de passe de l'infra docker compose (lus par infra/docker-compose.yml) ---
POSTGRES_PASSWORD=postgres
WASAFILI_OWNER_PASSWORD=wasafili_owner
WASAFILI_APP_PASSWORD=wasafili_app
MINIO_ROOT_USER=wasafili
MINIO_ROOT_PASSWORD=wasafili-minio-secret
S3_BUCKET=wasafili
