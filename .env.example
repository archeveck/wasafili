# Copier en `.env` à la racine. Les applications (api, worker) le chargent en développement ;
# en conteneur, les variables viennent de docker compose. Les valeurs ci-dessous correspondent
# à l'infra de dev (`pnpm infra:up`) — à remplacer intégralement en production.

# --- Commun ---
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- PostgreSQL ---
# Rôle applicatif (soumis à la RLS) : utilisé par l'api et le worker.
DATABASE_URL=postgresql://tesserax_app:tesserax_app@localhost:5440/tesserax
# Rôle propriétaire : utilisé uniquement par les migrations et le seed.
DATABASE_OWNER_URL=postgresql://tesserax_owner:tesserax_owner@localhost:5440/tesserax
# Base dédiée aux tests d'intégration (vidée par les tests).
TEST_DATABASE_URL=postgresql://tesserax_app:tesserax_app@localhost:5440/tesserax_test
TEST_DATABASE_OWNER_URL=postgresql://tesserax_owner:tesserax_owner@localhost:5440/tesserax_test

# --- Redis (BullMQ, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
# Secret de signature des jetons d'accès (HS256), 32 caractères minimum.
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Durées de vie (secondes)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Origines autorisées (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# --- Mots de passe de l'infra docker compose (lus par infra/docker-compose.yml) ---
POSTGRES_PASSWORD=postgres
TESSERAX_OWNER_PASSWORD=tesserax_owner
TESSERAX_APP_PASSWORD=tesserax_app
MINIO_ROOT_USER=tesserax
MINIO_ROOT_PASSWORD=tesserax-minio-secret
S3_BUCKET=tesserax
